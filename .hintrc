{
  "extends": [
    "development"
  ],
  "hints": {
    "axe/name-role-value": [
      "default",
      {
        "link-name": "off",
        "button-name": "off"
      }
    ],
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "-ms-filter",
          "-moz-backface-visibility"
        ]
      }
    ],
    "typescript-config/consistent-casing": "off",
    "no-inline-styles": "off"
  }
}